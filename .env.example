# Proposal Board → Supabase. Copy to .env.local and fill in from:
# Supabase Dashboard → Project Settings → API Keys (and Data API for the URL).
# Both values are safe to ship to the browser; the database's row-level security
# and server functions are what protect the data. NEVER put the secret /
# service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
